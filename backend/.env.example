# Copy this file to .env and fill in the values

# ---- Server ----
PORT=5001

# ---- Database ----
# MongoDB Atlas: Database > Connect > Drivers, e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
# Local MongoDB: mongodb://127.0.0.1:27017
MONGODB_URI=
DB_NAME=street_vendor

# ---- Login tokens ----
# Any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also used to encrypt vendors' saved Razorpay keys: if you change it, vendors must enter their keys again.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Online payments ----
# Every vendor connects their OWN Razorpay account in Dashboard > Settings > Payment options,
# so each shop's money goes to that shop. No Razorpay keys go in this file.
# Shops that haven't connected Razorpay get a simulated "demo" payment screen:
#   on  = demo payments allowed (default while developing)
#   off = those shops only take payment at the counter (default when NODE_ENV=production)
# DEMO_PAYMENTS=on

# Timezone used for daily token numbers and stats
TIMEZONE=Asia/Kolkata
