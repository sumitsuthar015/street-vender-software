# Copy this file to .env and fill in the values

# ---- Server ----
PORT=5001

# ---- Database ----
# MongoDB Atlas: Database > Connect > Drivers, e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
# Local MongoDB: mongodb://127.0.0.1:27017
MONGODB_URI=
DB_NAME=street_vendor

# ---- Login tokens ----
# Any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Online payments (Razorpay) ----
# Leave empty to use the built-in DEMO payment screen.
# For real payments: https://dashboard.razorpay.com > Account & Settings > API Keys (use Test Mode keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Razorpay dashboard > Webhooks > URL https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Timezone used for daily token numbers and stats
TIMEZONE=Asia/Kolkata
